#define MIMI_SECRET_PROXY_PORT      ""

/* Brave Search API */
#define MIMI_SECRET_SEARCH_KEY      ""

/* Chat Whitelist: comma-separated Telegram chat IDs allowed to talk to the bot.
 * Leave empty to allow ALL chats (no restriction).
 * Example: "123456789" or "123456789,987654321"
 */
#define MIMI_SECRET_ALLOWED_CHAT_ID ""
